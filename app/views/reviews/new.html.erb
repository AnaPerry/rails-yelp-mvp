<div class="container mt-5">
  <h2>Leave your review!</h2>
  <div class="my-4">
    <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :content %>
    <%= f.input :rating, :collection => 0..5 %>
    <%= f.submit "Submit Review", class:"btn btn-success"%>
    <% end %>
  </div>
</div>
